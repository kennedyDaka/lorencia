generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

enum AppRole {
  owner
  manager
  cashier
  storekeeper
  accountant

  @@schema("public")
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("profiles")
  @@schema("public")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  role       AppRole
  businessId String?  @db.Uuid @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId, role])
  @@map("user_roles")
  @@schema("public")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  tagline   String?
  createdAt DateTime @default(now()) @map("created_at")

  products              Product[]
  customers             Customer[]
  sales                 Sale[]
  expenses              Expense[]
  cateringEvents        CateringEvent[]
  cateringCosts         CateringCost[]
  rawMaterials          RawMaterial[]
  rawMaterialPurchases  RawMaterialPurchase[]
  fixedAssets           FixedAsset[]
  employees             Employee[]
  payrollSettings       PayrollSettings?
  payeBrackets          PayeBracket[]
  payrollEntries        PayrollEntry[]
  chartOfAccounts       ChartOfAccount[]
  journalEntries        JournalEntry[]
  stockMovements        StockMovement[]
  userRoles             UserRole[]

  @@map("businesses")
  @@schema("public")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @db.Uuid @map("business_id")
  name               String
  category           String?
  price              Decimal  @default(0) @db.Decimal(12, 2)
  stockQty           Decimal  @default(0) @map("stock_qty") @db.Decimal(12, 2)
  lowStockThreshold  Decimal  @default(5) @map("low_stock_threshold") @db.Decimal(12, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  stockMovements   StockMovement[]

  @@index([businessId, isActive])
  @@map("products")
  @@schema("public")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String?  @db.Uuid @map("business_id")
  name       String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  business       Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  sales          Sale[]
  cateringEvents CateringEvent[]

  @@index([businessId])
  @@map("customers")
  @@schema("public")
}

model Sale {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @db.Uuid @map("business_id")
  cashierId     String?   @db.Uuid @map("cashier_id")
  customerId    String?   @db.Uuid @map("customer_id")
  total         Decimal   @default(0) @db.Decimal(14, 2)
  paymentMethod String    @default("cash") @map("payment_method")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([cashierId])
  @@map("sales")
  @@schema("public")
}

model SaleItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid @map("sale_id")
  productId   String? @db.Uuid @map("product_id")
  productName String  @map("product_name")
  qty         Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
  @@schema("public")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid @map("business_id")
  category   String
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  createdBy  String?  @db.Uuid @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items          ExpenseItem[]
  rawMaterialPurchases RawMaterialPurchase[]
  cateringCosts  CateringCost[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([createdBy])
  @@map("expenses")
  @@schema("public")
}

model ExpenseItem {
  id              String   @id @default(uuid()) @db.Uuid
  expenseId       String   @db.Uuid @map("expense_id")
  description     String
  qty             Decimal  @default(1) @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  total           Decimal  @default(0) @db.Decimal(14, 2)
  inventoryType   String?  @map("inventory_type")
  inventoryItemId String?  @db.Uuid @map("inventory_item_id")
  createdAt       DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_items")
  @@schema("public")
}

model CateringEvent {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid @map("business_id")
  customerId     String?  @db.Uuid @map("customer_id")
  eventDate      DateTime @map("event_date") @db.Date
  venue          String?
  guests         Int      @default(0)
  quotedAmount   Decimal  @default(0) @map("quoted_amount") @db.Decimal(14, 2)
  depositPaid    Decimal  @default(0) @map("deposit_paid") @db.Decimal(14, 2)
  status         String   @default("pending")
  notes          String?
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  costs     CateringCost[]

  @@index([businessId, status, completedAt(sort: Desc)])
  @@map("catering_events")
  @@schema("public")
}

model CateringCost {
  id                String   @id @default(uuid()) @db.Uuid
  cateringEventId   String   @db.Uuid @map("catering_event_id")
  businessId        String   @db.Uuid @map("business_id")
  expenseId         String?  @db.Uuid @map("expense_id")
  category          String   @default("Catering Cost")
  description       String
  amount            Decimal  @db.Decimal(14, 2)
  createdBy         String?  @db.Uuid @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  cateringEvent CateringEvent @relation(fields: [cateringEventId], references: [id], onDelete: Cascade)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([cateringEventId])
  @@index([businessId, createdAt])
  @@map("catering_costs")
  @@schema("public")
}

model RawMaterial {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid @map("business_id")
  name              String
  category          String?
  unit              String   @default("kg")
  stockQty          Decimal  @default(0) @map("stock_qty") @db.Decimal(12, 2)
  unitCost          Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  lowStockThreshold Decimal  @default(5) @map("low_stock_threshold") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases RawMaterialPurchase[]
  stockMovements StockMovement[]

  @@index([businessId, isActive])
  @@map("raw_materials")
  @@schema("public")
}

model RawMaterialPurchase {
  id             String   @id @default(uuid()) @db.Uuid
  rawMaterialId  String   @db.Uuid @map("raw_material_id")
  businessId     String   @db.Uuid @map("business_id")
  qtyAdded       Decimal  @map("qty_added") @db.Decimal(12, 2)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 2)
  totalCost      Decimal  @map("total_cost") @db.Decimal(14, 2)
  note           String?
  expenseId      String?  @db.Uuid @map("expense_id")
  createdBy      String?  @db.Uuid @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([rawMaterialId])
  @@index([businessId])
  @@map("raw_material_purchases")
  @@schema("public")
}

model FixedAsset {
  id                     String   @id @default(uuid()) @db.Uuid
  businessId             String   @db.Uuid @map("business_id")
  name                   String
  description            String?
  category               String   @default("Equipment")
  purchaseDate           DateTime? @map("purchase_date") @db.Date
  purchaseCost           Decimal  @default(0) @map("purchase_cost") @db.Decimal(14, 2)
  currentValue           Decimal  @default(0) @map("current_value") @db.Decimal(14, 2)
  depreciationMethod     String?  @map("depreciation_method")
  depreciationRate       Decimal? @map("depreciation_rate") @db.Decimal(5, 2)
  depreciationFrequency  String?  @map("depreciation_frequency")
  lastDepreciationDate   DateTime? @map("last_depreciation_date") @db.Date
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("fixed_assets")
  @@schema("public")
}

model Employee {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @db.Uuid @map("business_id")
  name               String
  position           String?
  baseSalary         Decimal  @default(0) @map("base_salary") @db.Decimal(12, 2)
  payFrequency       String   @default("monthly") @map("pay_frequency")
  pensionEligible    Boolean  @default(false) @map("pension_eligible")
  pensionPercentage  Decimal? @map("pension_percentage") @db.Decimal(5, 2)
  overtimeRate       Decimal  @default(2) @map("overtime_rate") @db.Decimal(3, 2)
  hiredDate          DateTime? @map("hired_date") @db.Date
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollEntries PayrollEntry[]

  @@index([businessId])
  @@map("employees")
  @@schema("public")
}

model PayrollSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  businessId                String   @unique @db.Uuid @map("business_id")
  defaultPensionPercentage  Decimal  @default(5) @map("default_pension_percentage") @db.Decimal(5, 2)
  defaultOvertimeRate       Decimal  @default(2) @map("default_overtime_rate") @db.Decimal(3, 2)
  standardHoursPerPeriod    Decimal  @default(176) @map("standard_hours_per_period") @db.Decimal(6, 2)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
  @@schema("public")
}

model PayeBracket {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid @map("business_id")
  minIncome   Decimal  @default(0) @map("min_income") @db.Decimal(12, 2)
  maxIncome   Decimal? @map("max_income") @db.Decimal(12, 2)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("paye_brackets")
  @@schema("public")
}

model PayrollEntry {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid @map("employee_id")
  businessId       String   @db.Uuid @map("business_id")
  payPeriodStart   DateTime @map("pay_period_start") @db.Date
  payPeriodEnd     DateTime @map("pay_period_end") @db.Date
  grossPay         Decimal  @default(0) @map("gross_pay") @db.Decimal(12, 2)
  overtimeHours    Decimal  @default(0) @map("overtime_hours") @db.Decimal(6, 2)
  overtimePay      Decimal  @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  pensionDeduction Decimal  @default(0) @map("pension_deduction") @db.Decimal(12, 2)
  payeeTax         Decimal  @default(0) @map("payee_tax") @db.Decimal(12, 2)
  netPay           Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  status           String   @default("draft")
  paidAt           DateTime? @map("paid_at")
  notes            String?
  createdBy        String?  @db.Uuid @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([employeeId])
  @@map("payroll_entries")
  @@schema("public")
}

model ChartOfAccount {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid @map("business_id")
  code       String
  name       String
  type       String
  isSystem   Boolean  @default(false) @map("is_system")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("chart_of_accounts")
  @@schema("public")
}

model JournalEntry {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid @map("business_id")
  entryDate     DateTime @map("entry_date") @db.Date
  description   String
  referenceType String?  @map("reference_type")
  referenceId   String?  @db.Uuid @map("reference_id")
  createdBy     String?  @db.Uuid @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    JournalLine[]

  @@index([businessId, entryDate])
  @@map("journal_entries")
  @@schema("public")
}

model JournalLine {
  id              String   @id @default(uuid()) @db.Uuid
  journalEntryId  String   @db.Uuid @map("journal_entry_id")
  accountId       String   @db.Uuid @map("account_id")
  debit           Decimal  @default(0) @db.Decimal(14, 2)
  credit          Decimal  @default(0) @db.Decimal(14, 2)

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
  @@schema("public")
}

model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid @map("business_id")
  inventoryType  String   @map("inventory_type")
  productId      String?  @db.Uuid @map("product_id")
  rawMaterialId  String?  @db.Uuid @map("raw_material_id")
  qtyChange      Decimal  @map("qty_change") @db.Decimal(12, 2)
  previousQty    Decimal  @map("previous_qty") @db.Decimal(12, 2)
  newQty         Decimal  @map("new_qty") @db.Decimal(12, 2)
  reason         String   @default("stock_update")
  note           String?
  createdBy      String?  @db.Uuid @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  rawMaterial RawMaterial?  @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([rawMaterialId])
  @@map("stock_movements")
  @@schema("public")
}

model MalawiHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("malawi_holidays")
  @@schema("public")
}
